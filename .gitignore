# Python bytecode files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Environment variables
.env
.env.*
!.env.example

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# uv specific
.uv/
.uv-cache/

# Testing
.coverage
htmlcov/
.pytest_cache/
# Local pytest --basetemp dirs and the conftest fixture root
.pytest-tmp/
.tmp/

# Local configuration
config.local.json
claude_desktop_config.json

# Local agent & tool state — but keep shareable project slash commands tracked
.claude/*
!.claude/commands/
.playwright-mcp/

# Temporary files
*.tmp
*.bak
temp/

# Repomix
.repomix
repomix-output.txt
repomix-output.xml

# Personal vault data — notes, graph DB, embeddings cache, backups.
# The entire data/ tree is local user content; nothing in it is tracked.
/data/